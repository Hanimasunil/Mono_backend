# Complete CRUD API Endpoints

@csrf_exempt
def api_booking_slot_detail(request, pk):
    """GET/PUT/DELETE booking slot detail"""
    if request.method == 'GET':
        try:
            slot = get_object_or_404(BookingSlot, pk=pk)
            serializer = BookingSlotSerializer(slot)
            return JsonResponse({
                'success': True,
                'data': serializer.data
            })
        except Exception as e:
            return JsonResponse({
                'success': False,
                'error': str(e)
            }, status=400)
    
    elif request.method == 'PUT':
        try:
            slot = get_object_or_404(BookingSlot, pk=pk)
            data = json.loads(request.body)
            
            for field, value in data.items():
                if hasattr(slot, field):
                    setattr(slot, field, value)
            
            slot.save()
            serializer = BookingSlotSerializer(slot)
            return JsonResponse({
                'success': True,
                'data': serializer.data,
                'message': 'Booking slot updated successfully'
            })
        except Exception as e:
            return JsonResponse({
                'success': False,
                'error': str(e)
            }, status=400)
    
    elif request.method == 'DELETE':
        try:
            slot = get_object_or_404(BookingSlot, pk=pk)
            slot.delete()
            return JsonResponse({
                'success': True,
                'message': 'Booking slot deleted successfully'
            })
        except Exception as e:
            return JsonResponse({
                'success': False,
                'error': str(e)
            }, status=400)
    
    return JsonResponse({'success': False, 'error': 'Method not allowed'}, status=405)


@csrf_exempt
def api_booking_slot_create(request):
    """POST to create a booking slot"""
    if request.method == 'POST':
        try:
            data = json.loads(request.body)
            serializer = BookingSlotSerializer(data=data)
            if serializer.is_valid():
                slot = serializer.save()
                return JsonResponse({
                    'success': True,
                    'data': BookingSlotSerializer(slot).data,
                    'message': 'Booking slot created successfully'
                })
            else:
                return JsonResponse({
                    'success': False,
                    'error': serializer.errors
                }, status=400)
        except Exception as e:
            return JsonResponse({
                'success': False,
                'error': str(e)
            }, status=400)
    
    return JsonResponse({'success': False, 'error': 'Method not allowed'}, status=405)


@csrf_exempt
def api_booking_list(request):
    """GET all bookings or POST to create booking"""
    if request.method == 'GET':
        try:
            bookings = Booking.objects.all().order_by('-created_at')
            serializer = BookingSerializer(bookings, many=True)
            return JsonResponse({
                'success': True,
                'data': serializer.data,
                'count': len(serializer.data)
            })
        except Exception as e:
            return JsonResponse({
                'success': False,
                'error': str(e)
            }, status=400)
    
    elif request.method == 'POST':
        try:
            data = json.loads(request.body)
            serializer = BookingCreateSerializer(data=data)
            if serializer.is_valid():
                booking = serializer.save()
                # Update slot availability
                slot = booking.slot
                slot.current_bookings += 1
                if slot.current_bookings >= slot.max_bookings:
                    slot.status = 'booked'
                slot.save()
                
                return JsonResponse({
                    'success': True,
                    'data': BookingSerializer(booking).data,
                    'message': 'Booking created successfully'
                })
            else:
                return JsonResponse({
                    'success': False,
                    'error': serializer.errors
                }, status=400)
        except Exception as e:
            return JsonResponse({
                'success': False,
                'error': str(e)
            }, status=400)
    
    return JsonResponse({'success': False, 'error': 'Method not allowed'}, status=405)


@csrf_exempt
def api_booking_detail(request, pk):
    """GET/PUT/DELETE booking detail"""
    if request.method == 'GET':
        try:
            booking = get_object_or_404(Booking, pk=pk)
            serializer = BookingSerializer(booking)
            return JsonResponse({
                'success': True,
                'data': serializer.data
            })
        except Exception as e:
            return JsonResponse({
                'success': False,
                'error': str(e)
            }, status=400)
    
    elif request.method == 'PUT':
        try:
            booking = get_object_or_404(Booking, pk=pk)
            data = json.loads(request.body)
            
            old_status = booking.status
            for field, value in data.items():
                if hasattr(booking, field):
                    setattr(booking, field, value)
            
            booking.save()
            
            # Update slot availability if status changed
            if old_status != booking.status:
                slot = booking.slot
                if booking.status == 'cancelled':
                    if slot.current_bookings > 0:
                        slot.current_bookings -= 1
                        if slot.current_bookings < slot.max_bookings:
                            slot.status = 'available'
                slot.save()
            
            serializer = BookingSerializer(booking)
            return JsonResponse({
                'success': True,
                'data': serializer.data,
                'message': 'Booking updated successfully'
            })
        except Exception as e:
            return JsonResponse({
                'success': False,
                'error': str(e)
            }, status=400)
    
    elif request.method == 'DELETE':
        try:
            booking = get_object_or_404(Booking, pk=pk)
            # Update slot availability
            slot = booking.slot
            if slot.current_bookings > 0:
                slot.current_bookings -= 1
                if slot.current_bookings < slot.max_bookings:
                    slot.status = 'available'
            slot.save()
            
            booking.delete()
            return JsonResponse({
                'success': True,
                'message': 'Booking deleted successfully'
            })
        except Exception as e:
            return JsonResponse({
                'success': False,
                'error': str(e)
            }, status=400)
    
    return JsonResponse({'success': False, 'error': 'Method not allowed'}, status=405)


